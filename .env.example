# No API or WebSocket URL is required for the single-service deployment.
# Leave ALLOWED_ORIGINS empty unless you intentionally host a separate frontend.
ALLOWED_ORIGINS=

# Optional: enables Gemini-backed assistant answers. Keep this server-side only.
GEMINI_API_KEY=

# Optional local override. In the Docker/Railway deployment this is set to /data.
RAILETA_DATA_DIR=.
